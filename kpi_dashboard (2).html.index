</div>
<script>
const W={sasaki:{g1:50,g2:100,g3:2},sano:{g1:20,g2:60,g3:20},kase:{g1:50,g2:25,g3:25},sakuma:{g1:50,g2:30,g3:20}};
function stClass(p){return p>=80?'complete':p>=50?'progress':p>=20?'caution':'alert'}
function updateSlider(m,g,val){
  const p=parseInt(val),id=`${m}-${g}`,st=stClass(p);
  document.getElementById(`${id}-pct`).textContent=p+'%';
  document.getElementById(`${id}-pct`).className=`progress-pct c-${st}`;
  document.getElementById(`${id}-bar`).style.width=p+'%';
  document.getElementById(`${id}-bar`).className=`progress-fill fill-${st}`;
  document.getElementById(`${id}-sv`).textContent=p+'%';
  document.getElementById(`${id}-sv`).className=`slider-val c-${st}`;
  calcTotal(m);
  localStorage.setItem(`kpi6-slider-${id}`,p);
}
function calcTotal(m){
  const w=W[m];if(!w)return;
  let t=0;
  for(const[g,wt] of Object.entries(w)){const el=document.getElementById(`${m}-${g}-pct`);if(el)t+=(parseInt(el.textContent)/100)*wt;}
  const sc=Math.round(t),el=document.getElementById(`${m}-total`);
  if(el){el.textContent=sc;el.className=`score-num c-${stClass(sc)}`;}
}
function switchTab(id){
  ['sasaki','sano','kase','sakuma'].forEach(m=>{
    document.getElementById(`sec-${m}`).classList.remove('active');
    document.getElementById(`tab-${m}`).className='tab';
  });
  document.getElementById(`sec-${id}`).classList.add('active');
  document.getElementById(`tab-${id}`).className=`tab active-${id}`;
  calcTotal(id);
}
const DEFAULTS={
  sasaki:[
    {text:'AI実践2件目の着手内容を決めてSlackに宣言する',done:false},
    {text:'加瀬・佐久間の自走状況を1on1で確認する',done:false},
    {text:'ChatGPT工数シート分析の結果をチームに共有する',done:false},
  ],
  sano:[
    {text:'AIリサーチストック12案の現在数をSlackで報告する',done:false},
    {text:'TikTokシステムの完成状況をチームに共有する',done:false},
    {text:'引き継ぎ後も質問が来ている箇所のマニュアルを補強する',done:false},
  ],
  kase:[
    {text:'報酬計算を一人で完結できたか確認・報告する',done:false},
    {text:'マニュアルへのFB1件目を佐野さんへ提出する',done:false},
    {text:'AI活用業務を1件試みてSlackに投稿する',done:false},
  ],
  sakuma:[
    {text:'事業研修資料の発表を完了・報告する',done:false},
    {text:'AI実務報告3件の正式カウントを高木さんに確認する',done:false},
    {text:'4月の時短勤務体制で困ったことをSlackに共有する',done:false},
  ]
};
function loadActions(m){
  const raw=localStorage.getItem(`kpi6-actions-${m}`);
  if(!raw){const a=DEFAULTS[m].map(x=>({...x}));localStorage.setItem(`kpi6-actions-${m}`,JSON.stringify(a));return a;}
  return JSON.parse(raw);
}
function saveActions(m,a){localStorage.setItem(`kpi6-actions-${m}`,JSON.stringify(a))}
function renderActionList(m,actions){
  const c=document.getElementById(`${m}-actions`);c.innerHTML='';
  actions.forEach((a,i)=>{
    const div=document.createElement('div');
    div.className='action-item'+(a.done?' done':'');
    div.innerHTML=`<div class="action-check" onclick="toggleAction('${m}',${i})">${a.done?'✓':''}</div><span class="action-text">${esc(a.text)}</span>`;
    c.appendChild(div);
  });
}
function toggleAction(m,i){const actions=loadActions(m);actions[i].done=!actions[i].done;saveActions(m,actions);renderActionList(m,actions);}
function addAction(m){
  const inp=document.getElementById(`${m}-action-input`);const text=inp.value.trim();if(!text)return;
  const actions=loadActions(m);actions.push({text,done:false});saveActions(m,actions);renderActionList(m,actions);inp.value='';
}
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function saveComment(m){
  localStorage.setItem(`kpi6-comment-${m}`,document.getElementById(`${m}-comment`).value);
  const btn=event.target;btn.textContent='✓ 保存しました';btn.style.background='linear-gradient(135deg,var(--green),#06b6d4)';
  setTimeout(()=>{btn.textContent='保存する';btn.style.background='';},2000);
}
['sasaki','sano','kase','sakuma'].forEach(m=>{
  Object.keys(W[m]).forEach((g,idx)=>{
    const sv=localStorage.getItem(`kpi6-slider-${m}-${g}`);
    if(sv!==null){const inputs=document.querySelectorAll(`#sec-${m} input[type=range]`);if(inputs[idx]){inputs[idx].value=sv;updateSlider(m,g,sv);}}
  });
  const sc=localStorage.getItem(`kpi6-comment-${m}`);if(sc){const el=document.getElementById(`${m}-comment`);if(el)el.value=sc;}
  renderActionList(m,loadActions(m));
  calcTotal(m);
});
</script>
</body>
</html>
